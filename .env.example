# คัดลอกไฟล์นี้เป็น .env.local แล้วแก้ค่าตามต้องการ (ห้ามแชร์ไฟล์ .env.local เพราะมี API key)

# ผู้ให้บริการ AI: openrouter (ออนไลน์ มีโมเดลฟรี) หรือ ollama (รันบนเครื่อง)
AI_PROVIDER=openrouter

# --- OpenRouter --- สร้าง key ฟรีที่ https://openrouter.ai/keys
OPENROUTER_API_KEY=
# โมเดลเริ่มต้น (ต้องดูรูปได้; ลงท้าย :free = ฟรี) เปลี่ยนได้ในหน้าตั้งค่า
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b

# 1 = ใช้ผลวิเคราะห์จำลอง (ไม่เรียก AI จริง) เหมาะสำหรับลองหน้าตาแอป
AI_MOCK=0
